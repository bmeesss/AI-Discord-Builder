# Copy this file to .env and fill in the values for the provider you choose.
# Never commit .env or real API keys.

# --- Discord ---
DISCORD_TOKEN=

# --- AI provider: groq, openai or ollama ---
AI_PROVIDER=groq

# Cloud AI (only the selected provider needs a key)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint
# OPENAI_BASE_URL=

# Local AI via Ollama (no API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST_PORT=11434
OLLAMA_MODEL=qwen3:4b
LOCAL_AI_MODEL=qwen3:4b
LOCAL_AI_AUTO_SETUP=false
LOCAL_AI_AUTO_SELECT_MODEL=true

# --- Database (persistence: conversations, memories, rollback history) ---
# Backend selection: postgres (default, recommended for self-hosting) or
# supabase (optional cloud backend). Only one backend is used at a time.
DATABASE_BACKEND=postgres

# PostgreSQL: runs locally via Docker Compose, no cloud database required.
# The host 'db' below is the Compose service name; when you run the bot
# outside Docker, change the host to localhost (or your PostgreSQL host).
DATABASE_URL=postgresql://discord_builder:discord_builder@db:5432/discord_builder

# Connection pool and migration behavior
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_MIGRATE_ON_STARTUP=true

# Credentials for the PostgreSQL container itself (docker compose).
# CHANGE these for anything reachable beyond your own machine.
POSTGRES_USER=discord_builder
POSTGRES_PASSWORD=discord_builder
POSTGRES_DB=discord_builder

# --- Optional Supabase backend (only when DATABASE_BACKEND=supabase) ---
# SUPABASE_URL=
# SUPABASE_KEY=

# --- Runtime and safety ---
APP_ENV=production
WEB_HOST=0.0.0.0
WEB_PORT=8080
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/actions.log
REQUIRE_ADMIN=true
MAX_ACTIONS_PER_PLAN=40
MAX_AI_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=60
CONFIRMATION_TIMEOUT=120

# For Docker local AI, compose.local-ai.yaml overrides the bot URL to
# http://ollama:11434. The host-side setup CLI uses localhost:11434.
