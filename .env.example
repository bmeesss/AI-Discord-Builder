# Copy this file to .env and fill in the values for the provider you choose.
# Never commit .env or real API keys.

# --- Discord ---
DISCORD_TOKEN=

# --- AI provider: groq, openai or ollama ---
AI_PROVIDER=groq

# Cloud AI (only the selected provider needs a key)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint
# OPENAI_BASE_URL=

# Local AI via Ollama (no API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST_PORT=11434
OLLAMA_MODEL=qwen3:4b
LOCAL_AI_MODEL=qwen3:4b
LOCAL_AI_AUTO_SETUP=false
LOCAL_AI_AUTO_SELECT_MODEL=true

# --- Existing optional Supabase persistence ---
# The current repository uses these values when conversation/action persistence
# is enabled. Local AI does not require Supabase itself.
SUPABASE_URL=
SUPABASE_KEY=

# Reserved deployment setting for the future local database adapter. The current
# persistence code still reads SUPABASE_URL/SUPABASE_KEY.
DATABASE_URL=

# --- Runtime and safety ---
APP_ENV=production
WEB_HOST=0.0.0.0
WEB_PORT=8080
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/actions.log
REQUIRE_ADMIN=true
MAX_ACTIONS_PER_PLAN=40
MAX_AI_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=60
CONFIRMATION_TIMEOUT=120

# For Docker local AI, compose.local-ai.yaml overrides the bot URL to
# http://ollama:11434. The host-side setup CLI uses localhost:11434.
