# Copy this file to .env and fill in the values for the provider you choose.
# Never commit .env or real API keys.
#
# The bot is fully database-free: it needs NOTHING besides a Discord token
# and AI-provider configuration. Persistence lives in local JSON files.

# --- Discord ---
DISCORD_TOKEN=

# --- AI provider ---
# groq, openai, gemini, mistral, openrouter, deepseek, anthropic, xai,
# together, perplexity or ollama
AI_PROVIDER=groq

# Cloud AI (only the selected provider needs a key)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint
# OPENAI_BASE_URL=

# --- More cloud providers (optional, uncomment the one you use) ---
# All of these use the same OpenAI-compatible API; no extra dependencies.
# Check the provider's model page and override <X>_MODEL when needed.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-4-hydrogen
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# XAI_API_KEY=
# XAI_MODEL=grok-4.3
# TOGETHER_API_KEY=
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar

# Local AI via Ollama (no API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST_PORT=11434
OLLAMA_MODEL=qwen3:4b
LOCAL_AI_MODEL=qwen3:4b
LOCAL_AI_AUTO_SETUP=false
LOCAL_AI_AUTO_SELECT_MODEL=true

# --- Local JSON storage (no database) ---
# Directory for rollback history and conversation logs. Default: data
# (in Docker: /app/data on the named volume bot_data). Files are plain JSON.
# NOTE: on ephemeral hosts (e.g. Render Free) these files are lost on
# restart/redeploy/spin-down — see docs/self-hosting.md.
DATA_DIR=data

# --- Runtime and safety ---
APP_ENV=production
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Platform port override: when WEB_PORT is unset, the bot falls back to the
# PORT environment variable (Render sets PORT=10000 automatically) and then
# to 8080. You normally do not need to set PORT yourself.
# PORT=10000
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/actions.log
REQUIRE_ADMIN=true
MAX_ACTIONS_PER_PLAN=40
MAX_AI_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=60
CONFIRMATION_TIMEOUT=120

# For Docker local AI, compose.local-ai.yaml overrides the bot URL to
# http://ollama:11434. The host-side setup CLI uses localhost:11434.
