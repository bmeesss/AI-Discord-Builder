# CI additions for the Supabase -> PostgreSQL migration tool.
#
# This patch could not be pushed directly: the GitHub App used by this
# session has no `workflows` permission, so it may not create or update
# files under .github/workflows/.  Apply it with:
#
#     git apply docs/ci-migration-tests.patch
#
# It adds the migration unit tests to the unit-tests job and the real
# PostgreSQL migration tests to the postgres-integration job.
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 8187f70..5782856 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -34,6 +34,18 @@ jobs:
       - name: Unit tests (config validation included)
         run: python -m pytest -q --ignore=tests/integration
 
+      - name: Migration tool tests (export, verify, import, dry-run, idempotency)
+        run: |
+          python -m pytest -q \
+            tests/test_migration_model.py \
+            tests/test_migration_export.py \
+            tests/test_migration_validate.py \
+            tests/test_migration_import.py \
+            tests/test_migration_cli.py
+
+      - name: Test discovery also works with unittest
+        run: python -m unittest discover -q
+
   # Static validation of both Compose configurations. Runs without a daemon.
   docker-compose-config:
     runs-on: ubuntu-latest
@@ -93,3 +105,8 @@ jobs:
 
       - name: PostgreSQL integration tests (repositories, isolation, persistence, startup/restart/recovery)
         run: python -m pytest -q tests/integration/test_postgres_integration.py tests/integration/test_startup_flow.py
+
+      # Supabase -> PostgreSQL migration: export fixtures + real import,
+      # re-import (idempotency), relations, JSONB/timestamps, CLI end-to-end.
+      - name: Migration integration tests (real PostgreSQL)
+        run: python -m pytest -q tests/integration/test_migration_postgres_integration.py
